@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<!DOCTYPE html>
<html>
  <!DOCTYPE html>
  <html lang="en">
  <head>
	  <meta charset="UTF-8">
	  <meta name="viewport" content="width=device-width, initial-scale=1.0">
	  <title>CameraAnalytics</title>
	  <!-- Include the ECharts file you just downloaded -->
	  <script src="echarts.js"></script>
	  <style>
		  body {
			  font-family: Arial, sans-serif;
			  display: flex;
			  flex-direction: column;
			  align-items: center;
			  padding: 20px;
		  }
  
		  .form-container {
			  display: flex;
			  align-items: center;
			  gap: 20px; /* Adds space between elements */
			  padding: 15px;
			  border: 1px solid #ddd;
			  border-radius: 10px;
			  background-color: #f9f9f9;
			  width: 670px;
			  justify-content: space-between;
		  }
  
		  .form-group {
			  display: flex;
			  flex-direction: column;
			  align-items: flex-start;
		  }
  
		  label {
			  font-weight: bold;
			  margin-bottom: 5px;
		  }
  
		  input, select {
			  padding: 5px;
			  font-size: 14px;
			  width: 150px;
		  }
  
		  #cameraname {
			  width: 200px;
			  height: 60px; /* Adjusted for multiple selection */
		  }
  
		  button {
			  padding: 8px 15px;
			  font-size: 14px;
			  background-color: #007bff;
			  color: white;
			  border: none;
			  border-radius: 5px;
			  cursor: pointer;
			  align-self: flex-end;
		  }
  
		  button:hover {
			  background-color: #0056b3;
		  }
  
		  .results {
			  margin-top: 15px;
			  width: 600px;
			  text-align: left;
		  }
	  </style>
  </head>

  @using System.Text.Json
  	@{
    	var camerasJson = JsonSerializer.Serialize(Model.Cameras);
	}

	<script type="text/javascript">
	function showPplCount() {
		var schedule = document.getElementById('mealtype');
		var selectedScheduleID = schedule.value;

		fetch(`/Index?handler=GetScheduleByID&scheduleID=${selectedScheduleID}`)
		.then(response => {
    		if (!response.ok) {
      			throw new Error(`Server returned ${response.status}: ${response.statusText}`);
   			 }
    		return response.json();
  		})
		.then(data => {
			if (Array.isArray(data) && data.length > 0) {
				data.forEach(schedule => {
				selectedScheduleID = schedule.scheduleName;
				});
				showPplCount1(selectedScheduleID);
			} 
		})
		.catch(error => {
			console.error('Fetch error:', error);
		});
	}

	function showPplCount1(selectedSchedule) {

		const selectedOptions = Array.from(document.getElementById("cameraname").selectedOptions);
        const selectedIds = selectedOptions.map(opt => opt.value);
		var inputDateString = document.getElementById('Test_DatetimeLocal').value;
		var selectedDate1 = new Date(inputDateString);
		var selectedDate2 = new Date(inputDateString);

		if (selectedSchedule == "Breakfast") {
			selectedDate1.setHours(8, 0, 0, 0);
			selectedDate2.setHours(9, 30, 0, 0);
		}
		if (selectedSchedule == "Lunch") {
			selectedDate1.setHours(12, 30, 0, 0);
			selectedDate2.setHours(14, 0, 0, 0);
		}
		if (selectedSchedule == "Dinner") {
			selectedDate1.setHours(20, 0, 0, 0);
			selectedDate2.setHours(21, 30, 0, 0);
		}

		var t1 = Math.round(selectedDate1.getTime() / 1000);
		var t2 = Math.round(selectedDate2.getTime() / 1000);  

		const cameraParams = selectedIds.map(id => `cameraIds=${encodeURIComponent(id)}`).join('&');
		const timeParams = `from=${t1}&to=${t2}`;
		const queryString = `${cameraParams}&${timeParams}`;

		fetch(`/Index?handler=GetPeopleCount&${queryString}`)
		.then(response => response.json())
		.then(data => {
			document.getElementById('countLabel1').textContent = data.totalIn;
        	document.getElementById('countLabel2').textContent = data.totalOut;
		})
		.catch(error => {
			console.error("Error fetching people count:", error);
		});
	}
	</script>

<body>

    <div class="form-container">
        <div class="form-group">
            <label for="Test_DatetimeLocal">Date:</label>
            <input type="date" id="Test_DatetimeLocal">
        </div>

        <div class="form-group">
            <label for="cameraname">Camera Name:</label>
            <select name="cameraname" id="cameraname" multiple class="form-control">
            @foreach (var camera in Model.Cameras) {
                <option value="@camera.CameraID">@camera.CameraName</option> 
            }
        	</select>
        </div>

       <div class="form-group">
   		 <label for="mealtype">Schedule:</label>
   			<select name="mealtype" id="mealtype" class="form-control">
        		<option value="">-- Select a schedule --</option> <!-- Optional placeholder -->
    		</select>
		</div>
        
        <div id="showbutton" style="display: flex; align-items: center; height: 100%;">
            <button onclick="showPplCount()" style="padding: 8px 15px; font-size: 14px;">Get Count</button>
        </div>
    </div>

    <div class="results">
        <p><strong>Total In Count:</strong> <span id="countLabel1"></span></p>
        <p><strong>Total Out Count:</strong> <span id="countLabel2"></span></p>
		<p><strong></strong> <span id="tempLabel"></span></p>
    </div>

	<!-- Hidden inputs to store total counts -->
	<input type="hidden" id="totalIn" value="@Model.TotalIn" />
	<input type="hidden" id="totalOut" value="@Model.TotalOut" />

</body>
</html>

<script>
	document.getElementById('cameraname').addEventListener('change', function () {
		const selectedOptions = Array.from(this.selectedOptions);
		const selectedCameraIDs = selectedOptions.map(option => option.value);
		console.log("Selected Camera IDs:", selectedCameraIDs);

		fetch(`/Index?handler=GetSchedules&cameraId=${selectedCameraIDs[0]}`)
		.then(response => response.json())
		.then(data => {
			const mealTypeSelect = document.getElementById('mealtype');
            mealTypeSelect.innerHTML = ''; 
			data.forEach(schedule => {
                const option = document.createElement('option');
                option.value = schedule.scheduleID; 
                option.textContent = schedule.scheduleName;
                mealTypeSelect.appendChild(option);
            });
		})
		.catch(error => {
			console.error("Error fetching people count:", error);
		});
	
	});
</script>


